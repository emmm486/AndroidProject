<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="1dp"> <!-- 底部稍微留点缝隙区分每一项 -->

    <ImageView
        android:id="@+id/ivShopImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_card" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="商家名称"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⭐ 4.8  月售2000+ 距离1.2km"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvDelivery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="起送¥20 | 配送¥3 | 30分钟"
            android:textSize="12sp"
            android:textColor="#999999" />

        <!-- 新增：地址 -->
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="湘潭市雨湖区建设北路..."
            android:textSize="12sp"
            android:textColor="#999999"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 新增：公告 -->
        <TextView
            android:id="@+id/tvAnnouncement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="公告：黄焖鸡现焖现卖..."
            android:textSize="12sp"
            android:textColor="#FF5722"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</LinearLayout>
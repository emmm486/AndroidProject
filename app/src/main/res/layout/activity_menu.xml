<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部：返回 + 店名 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#333333" />

        <ImageView
            android:id="@+id/ivMenuShopImage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="商家名称"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- 新增：商家详情信息卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvMenuShopInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 4.8 | 月售1000 | 起送¥18 | 配送¥2.5"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvMenuShopAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="地址：湘潭市雨湖区..."
            android:textSize="12sp"
            android:textColor="#999999" />

        <TextView
            android:id="@+id/tvMenuShopAnnouncement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="公告：糖水冷热可选..."
            android:textSize="12sp"
            android:textColor="#FF5722" />
    </LinearLayout>

    <!-- 菜品列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dishList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF" />

    <!-- 底部购物车栏 (保持你原来的代码不变) -->
    <LinearLayout
        android:id="@+id/cartBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#333333">

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="0"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#FF5722" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="🛒 合计："
            android:textSize="15sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="¥ 0.0"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btnCheckout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="去结算"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:background="#FF5722" />
    </LinearLayout>
</LinearLayout>